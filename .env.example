# Demo works without an API key. Change to openai to enable real conversation.
GOVERNOR_PROVIDER=demo
OPENAI_API_KEY=
GOVERNOR_MODEL=gpt-5.4-mini
GOVERNOR_LOCAL_MODEL=qwen2.5:1.5b
GOVERNOR_WHISPER_MODEL=tiny.en
GOVERNOR_TRANSCRIBE_MODEL=gpt-transcribe
GOVERNOR_PORT=8765
GOVERNOR_DATA_DIR=./data
# Local synthesis: install espeak-ng on the Pi. Browser speech is a fallback.
GOVERNOR_VOICE=en-gb
GOVERNOR_SPEECH_RATE=145
# Camera is explicitly opt-in. USB UVC cameras use index 0.
GOVERNOR_CAMERA=false
GOVERNOR_CAMERA_INDEX=0
GOVERNOR_MODEL_DIR=./models
GOVERNOR_FACE_THRESHOLD=0.5
# Optional native microphone worker: device index or substring, blank = default.
GOVERNOR_INPUT_DEVICE=
GOVERNOR_OUTPUT_DEVICE=
GOVERNOR_VAD_THRESHOLD=0.025
